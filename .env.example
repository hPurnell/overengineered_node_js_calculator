# ---------------------------------------------------------------------------
# Computation API (apps/api)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# Absolute or relative path to the history datastore.
# NOTE: consumers never see this - it is an implementation detail of
# @calc/history-store. Swapping the driver only changes this value's meaning.
HISTORY_STORE_URL=file:./data/calculator.db

# Run outstanding migrations automatically on boot.
HISTORY_STORE_AUTO_MIGRATE=true

# Maximum number of history rows returned in a single page.
HISTORY_PAGE_MAX_SIZE=100

# ---------------------------------------------------------------------------
# Web client (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
