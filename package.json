{
  "name": "overengineered-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "A macOS Calculator clone with a separate computation backend and persisted history.",
  "engines": {
    "node": ">=20.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @calc/contracts && npm run build --workspace @calc/api && npm run build --workspace @calc/web",
    "build:packages": "npm run build --workspace @calc/contracts",
    "dev": "npm run build:packages && concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @calc/api",
    "dev:web": "npm run dev --workspace @calc/web",
    "start": "concurrently -n api,web -c magenta,cyan \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start --workspace @calc/api",
    "start:web": "npm run start --workspace @calc/web",
    "db:generate": "npm run db:generate --workspace @calc/api",
    "db:migrate": "npm run db:migrate --workspace @calc/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf packages/*/dist apps/api/dist apps/web/.next node_modules/.cache"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
